+    // Folia start - save-all
+    /**
+     * Saves every chunk holder in the region section ({@code sectionX}, {@code sectionZ}), and does nothing else: it
+     * does not flush. Must run on the tick thread that owns the section, so that the data it serialises is not being
+     * modified concurrently. Returns {@code false} if any holder could not be saved by the calling thread, which
+     * means the caller was not the owner and the section was NOT saved.
+     */
+    public boolean saveSection(final int sectionX, final int sectionZ) {
+        final int regionShift = this.world.moonrise$getRegionChunkShift();
+        final int width = 1 << regionShift;
+        final int offsetX = sectionX << regionShift;
+        final int offsetZ = sectionZ << regionShift;
+
+        boolean ok = true;
+        for (int dz = 0; dz < width; ++dz) {
+            for (int dx = 0; dx < width; ++dx) {
+                final int chunkX = offsetX | dx;
+                final int chunkZ = offsetZ | dz;
+                final NewChunkHolder holder = this.getChunkHolder(chunkX, chunkZ);
+                if (holder == null) {
+                    continue;
+                }
+                if (!TickThread.isTickThreadFor(this.world, chunkX, chunkZ)) {
+                    LOGGER.error("Cannot save chunk (" + chunkX + "," + chunkZ + ") in world '" + WorldUtil.getWorldName(this.world) + "' from a thread that does not own it");
+                    ok = false;
+                    continue;
+                }
+                try {
+                    holder.save(false);
+                } catch (final Throwable thr) {
+                    LOGGER.error("Failed to save chunk (" + chunkX + "," + chunkZ + ") in world '" + WorldUtil.getWorldName(this.world) + "'", thr);
+                    ok = false;
+                }
+            }
+        }
+        return ok;
+    }
+    // Folia end - save-all

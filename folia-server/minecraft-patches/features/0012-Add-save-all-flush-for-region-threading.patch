+    // Folia start - save-all
+    /**
+     * Blocks until every write that was pending in this world's chunk, entity and poi region file I/O when this method
+     * was called has been written, then forces the region files to disk. Unlike {@link #flush(ServerLevel)} this does
+     * not wait for the queue to become empty, because reads and new saves keep arriving on a running server and would
+     * postpone that forever. A write started after this call is only waited on if it reuses the task of a chunk that
+     * was already waited for. Must not be called from a tick thread.
+     *
+     * @param deadlineNanos {@link System#nanoTime()} value after which to give up waiting
+     * @return {@code false} if a pending write failed or the deadline passed, in which case the data is not on disk
+     */
+    public static boolean flushPendingWrites(final ServerLevel world, final long deadlineNanos) {
+        final java.util.List<ChunkIOTask> pending = new java.util.ArrayList<>();
+        for (final RegionFileType type : CACHED_REGIONFILE_TYPES) {
+            final RegionDataController controller = getControllerFor(world, type);
+            for (final java.util.Iterator<ChunkIOTask> iterator = controller.chunkTasks.valueIterator(); iterator.hasNext();) {
+                final ChunkIOTask task = iterator.next();
+                if (task.inProgressWrite != null) {
+                    pending.add(task);
+                }
+            }
+        }
+
+        boolean ok = true;
+        long failures = 1L;
+        for (final ChunkIOTask task : pending) {
+            final long key = CoordinateUtils.getChunkKey(task.chunkX, task.chunkZ);
+            while (task.regionDataController.chunkTasks.get(key) == task) {
+                if (task.failedWrite || System.nanoTime() - deadlineNanos > 0L) {
+                    ok = false;
+                    break;
+                }
+                Thread.yield();
+                failures = ConcurrentUtil.linearLongBackoff(failures, 125_000L, 5_000_000L); // 125us, 5ms
+            }
+            failures = 1L;
+        }
+
+        try {
+            flushRegionStorages(world);
+        } catch (final IOException ex) {
+            LOGGER.error("Exception when flushing regions in world '" + WorldUtil.getWorldName(world) + "'", ex);
+            ok = false;
+        }
+        return ok;
+    }
+    // Folia end - save-all
+

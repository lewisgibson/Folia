diff --git a/io/papermc/paper/threadedregions/RegionizedSaveAll.java b/io/papermc/paper/threadedregions/RegionizedSaveAll.java
new file mode 100644
index 0000000000000000000000000000000000000000..a127ce6afca5ed285f8d79af8fb4d9952400cc2c
--- /dev/null
+++ b/io/papermc/paper/threadedregions/RegionizedSaveAll.java
@@ -0,0 +1,211 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.common.util.WorldUtil;
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.LongArrayList;
+import it.unimi.dsi.fastutil.longs.LongIterator;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import org.slf4j.Logger;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Implements {@code save-all [flush]} for region threading.
+ *
+ * <p>
+ * Invariant: when the returned future completes with {@code true} and {@code flush} was requested, every chunk, entity
+ * chunk, poi chunk and player that was loaded and modified before {@link #saveAll} was called has been serialised and
+ * written to its file and the region files have been forced to disk. Nothing in that guarantee depends on the caller
+ * being a tick thread, and nothing here ever blocks a tick thread.
+ * </p>
+ *
+ * <p>
+ * Serialisation of a chunk or a player has to be done by the thread that owns it, so each region section and each
+ * player is saved by a task queued to its owner (the task queue moves the task correctly if the region merges or
+ * splits before it runs). The waiting for those tasks, and the waiting for the region file I/O to drain, is done by a
+ * dedicated thread that is not a tick thread, so that a single tick thread configuration cannot deadlock on its own
+ * region tasks. Level data and the global saved data are written by a task on the global region, which owns them.
+ * </p>
+ */
+public final class RegionizedSaveAll {
+
+    private static final Logger LOGGER = LogUtils.getClassLogger();
+
+    private static final long TIMEOUT_NANOS = TimeUnit.MINUTES.toNanos(10L);
+
+    // one at a time: overlapping save-alls would just contend for the same regions and the same I/O queue
+    private static final ExecutorService EXECUTOR = Executors.newSingleThreadExecutor((final Runnable run) -> {
+        final Thread thread = new Thread(run, "Save-all thread");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private RegionizedSaveAll() {}
+
+    /**
+     * Starts a save. The future completes with {@code true} once everything requested has been saved and, if
+     * {@code flush}, is durably on disk, and with {@code false} if any part failed or the server stopped first. It never
+     * completes exceptionally.
+     */
+    public static CompletableFuture<Boolean> saveAll(final MinecraftServer server, final boolean flush) {
+        final CompletableFuture<Boolean> ret = new CompletableFuture<>();
+        EXECUTOR.execute(() -> {
+            boolean result;
+            try {
+                result = run(server, flush);
+            } catch (final Throwable thr) {
+                LOGGER.error("save-all failed", thr);
+                result = false;
+            }
+            ret.complete(Boolean.valueOf(result));
+        });
+        return ret;
+    }
+
+    private static boolean await(final MinecraftServer server, final CountDownLatch latch, final long deadline, final String what) throws InterruptedException {
+        while (!latch.await(200L, TimeUnit.MILLISECONDS)) {
+            if (!server.isRunning()) {
+                LOGGER.error("save-all abandoned while waiting for " + what + ": the server is stopping");
+                return false;
+            }
+            if (System.nanoTime() - deadline > 0L) {
+                LOGGER.error("save-all timed out waiting for " + what + ", " + latch.getCount() + " still pending");
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean run(final MinecraftServer server, final boolean flush) throws InterruptedException {
+        final long deadline = System.nanoTime() + TIMEOUT_NANOS;
+        final AtomicBoolean ok = new AtomicBoolean(true);
+        final List<ServerLevel> levels = new ArrayList<>();
+        for (final ServerLevel level : server.getAllLevels()) {
+            levels.add(level);
+        }
+
+        // 1. snapshot every owned section of every region, atomically per world: a section cannot move between regions
+        // while the regioniser lock is held, so none can be missed by a merge or split in the middle of the walk
+        final List<LongArrayList> sectionsByWorld = new ArrayList<>();
+        int totalSections = 0;
+        for (final ServerLevel level : levels) {
+            final LongArrayList sections = new LongArrayList();
+            level.regioniser.computeForAllRegions((region) -> {
+                for (final LongIterator iterator = region.getOwnedSectionsUnsynchronised(); iterator.hasNext();) {
+                    sections.add(iterator.nextLong());
+                }
+            });
+            sectionsByWorld.add(sections);
+            totalSections += sections.size();
+        }
+        final List<ServerPlayer> players = new ArrayList<>(server.getPlayerList().getPlayers());
+
+        // 2. save everything on the thread that owns it
+        final CountDownLatch pending = new CountDownLatch(totalSections + players.size());
+
+        for (int i = 0, len = levels.size(); i < len; ++i) {
+            final ServerLevel level = levels.get(i);
+            final LongArrayList sections = sectionsByWorld.get(i);
+            final int shift = level.regioniser.sectionChunkShift;
+            for (int j = 0, jlen = sections.size(); j < jlen; ++j) {
+                final long sectionKey = sections.getLong(j);
+                final int sectionX = CoordinateUtils.getChunkX(sectionKey);
+                final int sectionZ = CoordinateUtils.getChunkZ(sectionKey);
+                RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(level, sectionX << shift, sectionZ << shift, () -> {
+                    try {
+                        if (!level.moonrise$getChunkTaskScheduler().chunkHolderManager.saveSection(sectionX, sectionZ)) {
+                            ok.set(false);
+                        }
+                    } catch (final Throwable thr) {
+                        LOGGER.error("Failed to save section (" + sectionX + "," + sectionZ + ") in world '" + WorldUtil.getWorldName(level) + "'", thr);
+                        ok.set(false);
+                    } finally {
+                        pending.countDown();
+                    }
+                });
+            }
+        }
+
+        for (final ServerPlayer player : players) {
+            final boolean scheduled = player.getBukkitEntity().taskScheduler.schedule(
+                (final ServerPlayer owned) -> {
+                    try {
+                        if (TickThread.isTickThreadFor(owned)) {
+                            server.getPlayerList().save(owned);
+                        } else {
+                            LOGGER.error("Cannot save player " + owned.getScoreboardName() + " from a thread that does not own it");
+                            ok.set(false);
+                        }
+                    } catch (final Throwable thr) {
+                        LOGGER.error("Failed to save player " + owned.getScoreboardName(), thr);
+                        ok.set(false);
+                    } finally {
+                        pending.countDown();
+                    }
+                },
+                // retired: the player disconnected, and PlayerList#remove saves the player before it retires the scheduler
+                (final ServerPlayer retired) -> pending.countDown(),
+                1L
+            );
+            if (!scheduled) {
+                pending.countDown();
+            }
+        }
+
+        if (!await(server, pending, deadline, "region and player saves")) {
+            return false;
+        }
+
+        // 3. level data and global saved data belong to the global region
+        final CompletableFuture<Boolean> global = new CompletableFuture<>();
+        RegionizedServer.getInstance().addTask(() -> {
+            boolean globalOk = true;
+            try {
+                server.saveGlobalData(flush);
+                for (final ServerLevel level : levels) {
+                    try {
+                        new org.bukkit.event.world.WorldSaveEvent(level.getWorld()).callEvent();
+                        level.saveLevelData(flush);
+                    } catch (final Throwable thr) {
+                        LOGGER.error("Failed to save level data for world '" + WorldUtil.getWorldName(level) + "'", thr);
+                        globalOk = false;
+                    }
+                }
+            } catch (final Throwable thr) {
+                LOGGER.error("Failed to save global data", thr);
+                globalOk = false;
+            }
+            global.complete(Boolean.valueOf(globalOk));
+        });
+        final CountDownLatch globalLatch = new CountDownLatch(1);
+        global.whenComplete((final Boolean result, final Throwable thr) -> globalLatch.countDown());
+        if (!await(server, globalLatch, deadline, "global data")) {
+            return false;
+        }
+        if (!global.join().booleanValue()) {
+            ok.set(false);
+        }
+
+        // 4. every write the saves above queued is in a file, and the files are on disk
+        if (flush) {
+            for (final ServerLevel level : levels) {
+                if (!MoonriseRegionFileIO.flushPendingWrites(level, deadline)) {
+                    ok.set(false);
+                }
+            }
+        }
+
+        return ok.get();
+    }
+}

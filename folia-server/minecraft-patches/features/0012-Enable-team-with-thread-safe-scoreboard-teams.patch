+    private void broadcastTeamPacket(final Packet<?> packet) {
+        for (ServerPlayer serverPlayer : this.server.getPlayerList().getPlayers()) {
+            final net.minecraft.server.network.ServerGamePacketListenerImpl connection = serverPlayer.connection;
+            if (connection != null && connection.teamsSynced && serverPlayer.getBukkitEntity().getScoreboard().getHandle() == this) {
+                connection.send(packet);
+            }
+        }
+    }
+
+    /**
+     * Sends the teams to a player that has just joined and starts sending it team changes. Safe to call from the
+     * player's own region while another thread runs /team.
+     */
+    public void syncTeamsTo(final ServerPlayer player) {
+        synchronized (this.teamLock) {
+            if (player.getBukkitEntity().getScoreboard().getHandle() != this) {
+                return;
+            }
+            for (final PlayerTeam team : this.getPlayerTeams()) {
+                player.connection.send(ClientboundSetPlayerTeamPacket.createAddOrModifyPacket(team, true));
+            }
+            player.connection.teamsSynced = true;
+        }
+    }
+    // Folia end - region threading

     );
 
     public static void register(final CommandDispatcher<CommandSourceStack> dispatcher, final CommandBuildContext context) {
-        dispatcher.register(
+        dispatcher.register(onGlobalRegion( // Folia - region threading
             Commands.literal("team")
                 .requires(Commands.hasPermission(Commands.LEVEL_GAMEMASTERS))
                 .then(
@@ -266,8 +266,37 @@ public class TeamCommand {
                                 )
                         )
                 )
-        );
+        )); // Folia - region threading
+    }
+
+    // Folia start - region threading
+    private static com.mojang.brigadier.builder.LiteralArgumentBuilder<CommandSourceStack> onGlobalRegion(final com.mojang.brigadier.builder.LiteralArgumentBuilder<CommandSourceStack> team) {
+        return (com.mojang.brigadier.builder.LiteralArgumentBuilder<CommandSourceStack>)onGlobalRegion(team.build());
+    }
+
+    private static com.mojang.brigadier.builder.ArgumentBuilder<CommandSourceStack, ?> onGlobalRegion(final com.mojang.brigadier.tree.CommandNode<CommandSourceStack> node) {
+        final com.mojang.brigadier.builder.ArgumentBuilder<CommandSourceStack, ?> builder = node.createBuilder();
+        final Command<CommandSourceStack> command = node.getCommand();
+        if (command != null) {
+            builder.executes(context -> {
+                io.papermc.paper.threadedregions.RegionizedServer.getInstance().addTask(() -> {
+                    try {
+                        command.run(context);
+                    } catch (final CommandSyntaxException ex) {
+                        context.getSource().sendFailure((Component)ex.getRawMessage());
+                    }
+                });
+                return Command.SINGLE_SUCCESS;
+            });
+        }
+
+        for (final com.mojang.brigadier.tree.CommandNode<CommandSourceStack> child : node.getChildren()) {
+            builder.then(onGlobalRegion(child));
+        }
+
+        return builder;
     }
+    // Folia end - region threading
 
     private static Component getFirstMemberName(final Collection<ScoreHolder> members) {
         return members.iterator().next().getFeedbackDisplayName();

+    private static final long QUEUED_TASK_TIMEOUT_NANOS = java.util.concurrent.TimeUnit.SECONDS.toNanos(20L);
+    private static final ThreadLocal<RconConsoleSource> RUNNING_COMMAND_OF = new ThreadLocal<>();
+    private final java.util.concurrent.ConcurrentLinkedQueue<java.util.concurrent.CompletableFuture<?>> queuedTasks = new java.util.concurrent.ConcurrentLinkedQueue<>();
+
+    /**
+     * Runs the command of this source, so that every task the command itself queues for a region or the global region is waited for before the rcon response is sent, see {@link #trackQueuedTask}.
+     */
+    public void runCommand(final Runnable command) {
+        final RconConsoleSource previous = RUNNING_COMMAND_OF.get();
+        RUNNING_COMMAND_OF.set(this);
+        try {
+            command.run();
+        } finally {
+            RUNNING_COMMAND_OF.set(previous);
+        }
+    }
+
+    /**
+     * Registers work that the running rcon command starts on another thread and returns the callback that says it is done,
+     * or null if the calling thread is not running an rcon command. The rcon response waits for the callback, so that
+     * what the work writes to the source is part of the response. Only the work that the command itself starts is waited
+     * for, not the work that this work starts in turn, because a plugin task that reschedules itself would never end.
+     */
+    public static Runnable trackQueuedWork() {
+        final RconConsoleSource source = RUNNING_COMMAND_OF.get();
+        if (source == null) {
+            return null;
+        }
+        final java.util.concurrent.CompletableFuture<Void> done = new java.util.concurrent.CompletableFuture<>();
+        source.queuedTasks.add(done);
+        return () -> done.complete(null);
+    }
+
+    /**
+     * Wraps a task that is being queued for another thread so that the rcon response of the running command waits for
+     * it, see {@link #trackQueuedWork}. Returns the task unchanged if the calling thread is not running an rcon command.
+     */
+    public static Runnable trackQueuedTask(final Runnable task) {
+        final Runnable done = trackQueuedWork();
+        if (done == null) {
+            return task;
+        }
+        return () -> {
+            try {
+                task.run();
+            } finally {
+                done.run();
+            }
+        };
+    }
+
     /**
      * Blocks until every registered completion has completed, or the timeout has passed. Must not be called by a tick thread.
      */
     public void awaitPendingCompletions(final long timeout, final java.util.concurrent.TimeUnit unit) {
-        final long deadline = System.nanoTime() + unit.toNanos(timeout);
+        this.awaitCompletions(this.pendingCompletions, System.nanoTime() + unit.toNanos(timeout));
+        // a queued task that never runs, such as one dropped by a region that was merged away, must not hold the response for ever
+        this.awaitCompletions(this.queuedTasks, System.nanoTime() + QUEUED_TASK_TIMEOUT_NANOS);
+    }
+
+    private void awaitCompletions(final java.util.concurrent.ConcurrentLinkedQueue<java.util.concurrent.CompletableFuture<?>> completions, final long deadline) {
         java.util.concurrent.CompletableFuture<?> completion;
-        while ((completion = this.pendingCompletions.poll()) != null) {
+        while ((completion = completions.poll()) != null) {
             try {
                 completion.get(Math.max(0L, deadline - System.nanoTime()), java.util.concurrent.TimeUnit.NANOSECONDS);
             } catch (final java.util.concurrent.TimeoutException ex) {

From: Lewis Gibson <12851394+lewisgibson@users.noreply.github.com>
Date: Thu, 1 Oct 2026 18:20:33 +0100
Subject: [PATCH] Hand the bucket empty result to its caller through a
 ThreadLocal

BucketItem kept the item that a PlayerBucketEmptyEvent listener left in
the hand in a static field, written by emptyContents and read and cleared
by getEmptySuccessItem a few calls later. With regions ticking in
parallel, two players emptying buckets at the same time can overwrite
each other's field, so one of them gets the other's item, or the default
bucket, back in their hand.

Make the hand-off a ThreadLocal. A region never runs two of those calls
interleaved on one thread.

diff --git a/net/minecraft/world/item/BucketItem.java b/net/minecraft/world/item/BucketItem.java
index 42fbfb0e3eff318742928a94bddc0fbcc4d45596..9ed727048ac2c513b6c805100109e9b874fc7eb4 100644
--- a/net/minecraft/world/item/BucketItem.java
+++ b/net/minecraft/world/item/BucketItem.java
@@ -32,7 +32,7 @@ import net.minecraft.world.phys.HitResult;
 import org.jspecify.annotations.Nullable;
 
 public class BucketItem extends Item implements DispensibleContainerItem {
-    private static @Nullable ItemStack itemLeftInHandAfterPlayerBucketEmptyEvent = null; // Paper - Fix PlayerBucketEmptyEvent result itemstack
+    private static final ThreadLocal<@Nullable ItemStack> itemLeftInHandAfterPlayerBucketEmptyEvent = new ThreadLocal<>(); // Paper - Fix PlayerBucketEmptyEvent result itemstack // Folia - region threading - handed over on one thread, never shared between regions
     protected final Fluid content;
 
     public BucketItem(final Fluid content, final Item.Properties properties) {
@@ -109,9 +109,9 @@ public class BucketItem extends Item implements DispensibleContainerItem {
 
     public static ItemStack getEmptySuccessItem(final ItemStack itemStack, final Player player) {
         // Paper start - Fix PlayerBucketEmptyEvent result itemstack
-        if (itemLeftInHandAfterPlayerBucketEmptyEvent != null) {
-            ItemStack itemInHand = itemLeftInHandAfterPlayerBucketEmptyEvent;
-            itemLeftInHandAfterPlayerBucketEmptyEvent = null;
+        final ItemStack itemInHand = itemLeftInHandAfterPlayerBucketEmptyEvent.get(); // Folia - region threading
+        if (itemInHand != null) {
+            itemLeftInHandAfterPlayerBucketEmptyEvent.remove(); // Folia - region threading
             return itemInHand;
         }
         // Paper end - Fix PlayerBucketEmptyEvent result itemstack
@@ -147,7 +147,7 @@ public class BucketItem extends Item implements DispensibleContainerItem {
                     player.containerMenu.sendAllDataToRemote(); // SPIGOT-4541
                     return false;
                 }
-                itemLeftInHandAfterPlayerBucketEmptyEvent = event.getItemStack() != null ? event.getItemStack().equals(org.bukkit.craftbukkit.inventory.CraftItemStack.asNewCraftStack(net.minecraft.world.item.Items.BUCKET)) ? null : org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(event.getItemStack()) : ItemStack.EMPTY; // Paper - Fix PlayerBucketEmptyEvent result itemstack
+                itemLeftInHandAfterPlayerBucketEmptyEvent.set(event.getItemStack() != null ? event.getItemStack().equals(org.bukkit.craftbukkit.inventory.CraftItemStack.asNewCraftStack(net.minecraft.world.item.Items.BUCKET)) ? null : org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(event.getItemStack()) : ItemStack.EMPTY); // Paper - Fix PlayerBucketEmptyEvent result itemstack // Folia - region threading
             }
             // CraftBukkit end
             if (!canPlaceFluidInsideBlock) {

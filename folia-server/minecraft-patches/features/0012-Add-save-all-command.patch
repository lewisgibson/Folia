diff --git a/net/minecraft/server/rcon/RconConsoleSource.java b/net/minecraft/server/rcon/RconConsoleSource.java
index 7422b29719df2c7615fb894c52e426da608f20f7..a13bc3b9a4e655f009c67411da6c0b9cb0090a8a 100644
--- a/net/minecraft/server/rcon/RconConsoleSource.java
+++ b/net/minecraft/server/rcon/RconConsoleSource.java
@@ -26,8 +26,35 @@ public class RconConsoleSource implements CommandSource {
 
     public void prepareForCommand() {
         this.buffer.setLength(0);
+        this.pendingCompletions.clear(); // Folia - region threading
     }
 
+    // Folia start - region threading
+    private final java.util.concurrent.ConcurrentLinkedQueue<java.util.concurrent.CompletableFuture<?>> pendingCompletions = new java.util.concurrent.ConcurrentLinkedQueue<>();
+
+    public void addPendingCompletion(final java.util.concurrent.CompletableFuture<?> completion) {
+        this.pendingCompletions.add(completion);
+    }
+
+    public void awaitPendingCompletions(final long timeout, final java.util.concurrent.TimeUnit unit) {
+        final long deadline = System.nanoTime() + unit.toNanos(timeout);
+        java.util.concurrent.CompletableFuture<?> completion;
+        while ((completion = this.pendingCompletions.poll()) != null) {
+            try {
+                completion.get(Math.max(0L, deadline - System.nanoTime()), java.util.concurrent.TimeUnit.NANOSECONDS);
+            } catch (final java.util.concurrent.TimeoutException ex) {
+                MinecraftServer.LOGGER.error("Timed out waiting for an rcon command to finish replying");
+                return;
+            } catch (final InterruptedException ex) {
+                Thread.currentThread().interrupt();
+                return;
+            } catch (final java.util.concurrent.ExecutionException ex) {
+                MinecraftServer.LOGGER.error("An rcon command failed to reply", ex);
+            }
+        }
+    }
+    // Folia end - region threading
+
     public String getCommandResponse() {
         return this.buffer.toString();
     }

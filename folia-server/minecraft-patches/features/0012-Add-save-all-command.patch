From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lewis Gibson <12851394+lewisgibson@users.noreply.github.com>
Date: Thu, 1 Oct 2026 22:28:52 +0100
Subject: [PATCH] Add save-all command

Folia does not register save-all, so backup scripts that run save-off,
save-all flush and save-on fail. Each region section and player is saved by
the thread that owns it, and the command replies once the files are on disk.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index 8b06d0c893e07c969d35c4d7528927552c27b48b..a28a1a8f499588dba9fff3a7eaffa18033564dfc 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -463,6 +463,24 @@ public final class ChunkHolderManager {
         }
     }
 
+    // Folia start - region threading
+    public void saveSection(final int sectionX, final int sectionZ) {
+        final int regionShift = this.world.moonrise$getRegionChunkShift();
+        final int width = 1 << regionShift;
+        final int offsetX = sectionX << regionShift;
+        final int offsetZ = sectionZ << regionShift;
+
+        for (int dz = 0; dz < width; ++dz) {
+            for (int dx = 0; dx < width; ++dx) {
+                final NewChunkHolder holder = this.getChunkHolder(offsetX | dx, offsetZ | dz);
+                if (holder != null) {
+                    holder.save(false);
+                }
+            }
+        }
+    }
+    // Folia end - region threading
+
     private final ThreadedTicketLevelPropagator ticketLevelPropagator = new ThreadedTicketLevelPropagator() {
         @Override
         protected void processLevelUpdates(final Long2ByteLinkedOpenHashMap updates) {

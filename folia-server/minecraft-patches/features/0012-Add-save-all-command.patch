diff --git a/net/minecraft/server/commands/SaveAllCommand.java b/net/minecraft/server/commands/SaveAllCommand.java
index 299991905c24a7018f8ac60d0c16e56fa43cd710..789c8e9d56a460ff0912d360449b341ec9dce657 100644
--- a/net/minecraft/server/commands/SaveAllCommand.java
+++ b/net/minecraft/server/commands/SaveAllCommand.java
@@ -3,15 +3,12 @@ package net.minecraft.server.commands;
 import com.mojang.brigadier.Command;
 import com.mojang.brigadier.CommandDispatcher;
 import com.mojang.brigadier.exceptions.CommandSyntaxException;
-import com.mojang.brigadier.exceptions.SimpleCommandExceptionType;
 import net.minecraft.commands.CommandSourceStack;
 import net.minecraft.commands.Commands;
 import net.minecraft.network.chat.Component;
 import net.minecraft.server.MinecraftServer;
 
 public class SaveAllCommand {
-    private static final SimpleCommandExceptionType ERROR_FAILED = new SimpleCommandExceptionType(Component.translatable("commands.save.failed"));
-
     public static void register(final CommandDispatcher<CommandSourceStack> dispatcher) {
         dispatcher.register(
             Commands.literal("save-all")
@@ -24,12 +21,77 @@ public class SaveAllCommand {
     private static int saveAll(final CommandSourceStack source, final boolean flush) throws CommandSyntaxException {
         source.sendSuccess(() -> Component.translatable("commands.save.saving"), false);
         MinecraftServer server = source.getServer();
-        boolean success = server.saveEverything(true, flush, true);
-        if (!success) {
-            throw ERROR_FAILED.create();
+        // Folia start - region threading
+        final java.util.List<java.util.concurrent.CompletableFuture<Void>> saves = new java.util.ArrayList<>();
+        for (final net.minecraft.server.level.ServerLevel level : server.getAllLevels()) {
+            final it.unimi.dsi.fastutil.longs.LongArrayList sections = new it.unimi.dsi.fastutil.longs.LongArrayList();
+            level.regioniser.computeForAllRegions((region) -> {
+                for (final it.unimi.dsi.fastutil.longs.LongIterator iterator = region.getOwnedSectionsUnsynchronised(); iterator.hasNext();) {
+                    sections.add(iterator.nextLong());
+                }
+            });
+            final int shift = level.regioniser.sectionChunkShift;
+            for (final long section : sections) {
+                final int sectionX = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkX(section);
+                final int sectionZ = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkZ(section);
+                saves.add(java.util.concurrent.CompletableFuture.runAsync(
+                    () -> level.moonrise$getChunkTaskScheduler().chunkHolderManager.saveSection(sectionX, sectionZ),
+                    (final Runnable run) -> io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(level, sectionX << shift, sectionZ << shift, run)
+                ));
+            }
+        }
+        for (final net.minecraft.server.level.ServerPlayer player : server.getPlayerList().getPlayers()) {
+            final java.util.concurrent.CompletableFuture<Void> save = new java.util.concurrent.CompletableFuture<>();
+            saves.add(save);
+            if (!player.getBukkitEntity().taskScheduler.schedule(
+                (final net.minecraft.server.level.ServerPlayer owned) -> {
+                    try {
+                        server.getPlayerList().save(owned);
+                    } finally {
+                        save.complete(null);
+                    }
+                },
+                (final net.minecraft.server.level.ServerPlayer retired) -> save.complete(null),
+                1L
+            )) {
+                save.complete(null);
+            }
         }
+        saves.add(java.util.concurrent.CompletableFuture.runAsync(() -> {
+            server.saveGlobalData(flush);
+            for (final net.minecraft.server.level.ServerLevel level : server.getAllLevels()) {
+                new org.bukkit.event.world.WorldSaveEvent(level.getWorld()).callEvent();
+                level.saveLevelData(flush);
+            }
+        }, io.papermc.paper.threadedregions.RegionizedServer.getInstance()::addTask));
 
-        source.sendSuccess(() -> Component.translatable("commands.save.success"), true);
+        // the command runs on the global region, so wait for the saves and flush the files from another thread
+        final java.util.concurrent.CompletableFuture<Void> replied = new java.util.concurrent.CompletableFuture<>();
+        if (source.source instanceof net.minecraft.server.rcon.RconConsoleSource rcon) {
+            rcon.addPendingCompletion(replied);
+        }
+        java.util.concurrent.CompletableFuture.allOf(saves.toArray(new java.util.concurrent.CompletableFuture[0])).thenRunAsync(() -> {
+            if (!flush) {
+                return;
+            }
+            try {
+                for (final net.minecraft.server.level.ServerLevel level : server.getAllLevels()) {
+                    ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flush(level);
+                    ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO.flushRegionStorages(level);
+                }
+            } catch (final java.io.IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+        }, net.minecraft.util.Util.backgroundExecutor()).whenComplete((final Void result, final Throwable thr) -> {
+            if (thr == null) {
+                source.sendSuccess(() -> Component.translatable("commands.save.success"), true);
+            } else {
+                MinecraftServer.LOGGER.error("Failed to save the game", thr);
+                source.sendFailure(Component.translatable("commands.save.failed"));
+            }
+            replied.complete(null);
+        });
+        // Folia end - region threading
         return Command.SINGLE_SUCCESS;
     }
 }
